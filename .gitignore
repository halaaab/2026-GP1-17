# Secrets: API keys and passwords
.env
.env.*
!.env.example

# Survival model data: stays in Google Drive, never in Git
ml/data/
ml/**/*.csv
ml/**/*.xlsx
ml/**/*.parquet
# Except the counts-only reports (counts and names of categories, no business records)
!ml/reports/*.csv

# Private partner data: never uploaded
datasets/**/zid*
datasets/**/crunchbase*

# Research papers: list links, don't upload PDFs
resources/papers/*.pdf

# Installed packages and build output (regenerated by install commands)
node_modules/
dist/
__pycache__/
.venv/
venv/
.ipynb_checkpoints/

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
.idea/

# Project documents and evaluation evidence: kept only on Hala's Mac, never on GitHub
resources/docs/
evaluation/

# Logs and test output
*.log
npm-debug.log*
coverage/

# The agent server uses npm (package-lock.json); a pnpm lockfile is a local leftover
agent-server/pnpm-lock.yaml
