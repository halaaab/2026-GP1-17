# Secrets: API keys and passwords
.env
.env.*
!.env.example

# Survival model raw data: stays on your machine (license + size)
datasets/survival-model/raw/*
!datasets/survival-model/raw/.gitkeep

# Private partner data: never uploaded
datasets/**/zid*

# Research papers: list links, don't upload PDFs
resources/papers/*.pdf

# Installed packages and build output (regenerated by install commands)
node_modules/
dist/
__pycache__/
.venv/
venv/
.ipynb_checkpoints/

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
