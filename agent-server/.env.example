# Darb agent server keys.
# Copy this file to .env and fill in the values. Never commit .env or share keys in chat.

# OpenAI: lets the agents think and create embeddings.
# Get it from platform.openai.com, under API keys. Starts with sk-
OPENAI_API_KEY=

# Tavily: lets the agents search the web and read companies' pages.
# Get it from your tavily.com dashboard. Starts with tvly-
TAVILY_API_KEY=

# Supabase: the address of the Darb project. Looks like https://xxxx.supabase.co
# Get it from Connect in Supabase, or from Data API.
SUPABASE_URL=

# Supabase publishable key: the public key. Row Level Security still applies.
# Get it from Settings, API Keys. Starts with sb_publishable_
SUPABASE_ANON_KEY=

# Supabase secret key: the master key. It bypasses Row Level Security.
# Server only: never put it in the website code. Starts with sb_secret_
SUPABASE_SERVICE_ROLE_KEY=

# Database connection: where Mastra saves agent memory. Includes the database password.
# Get it from Connect, Direct, Session pooler. Starts with postgresql://
DATABASE_URL=

# Login check. "dev" lets Mastra Studio work without signing in (testing only).
# Live, set it to "required": every request then needs the founder's Supabase access token.
# If left empty, it is "required" when NODE_ENV=production and "dev" otherwise.
AUTH_MODE=dev

# Live only: the address of the Darb website, so only it may call this server. Several are separated by commas.
# Example: https://darb.sa
WEBSITE_ORIGIN=

# ML service: the address of the survival prediction service (FastAPI), without /predict.
# Leave empty until the ML team deploys it; the agent then says the prediction is not available yet.
# Example: http://localhost:8000
ML_SERVICE_URL=

# CR check: the small numbers-only file made by "npm run prepare:cr" from the Ministry of Commerce
# active-registrations files (once per quarter). Full path. If empty, every CR check answers "unknown".
# Example: /Users/you/Darb/2026-GP1-G17/agent-server/data/cr/cr-numbers-2026-q3.txt.gz
CR_NUMBERS_FILE=
