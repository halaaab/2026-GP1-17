{
  "name": "agent-server",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "test": "vitest run",
    "embed:startups": "tsx scripts/embed-startups.ts",
    "test:assessment": "tsx scripts/create-test-assessment.ts",
    "classify:startups": "tsx scripts/classify-startups-isic.ts",
    "test:live": "tsx scripts/test-live.ts",
    "test:coverage": "vitest run --coverage --coverage.include=src/** --coverage.exclude=src/**/*.test.ts --coverage.reporter=text-summary",
    "eval:similarity": "tsx scripts/evaluate-similarity.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.80.0",
    "@mastra/duckdb": "1.16.0",
    "@mastra/libsql": "1.27.1",
    "@mastra/memory": "^1.39.1",
    "@mastra/observability": "1.22.0",
    "@mastra/pg": "^1.33.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tavily/core": "^0.7.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@vitest/coverage-v8": "^3.2.7",
    "mastra": "1.36.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
